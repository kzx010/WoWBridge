# cmake -DOUT=<file.cpp> -DSYMBOL=<name> -DFILES=<a.lua;b.lua> -P embed.cmake
# Embeds text files as a null-terminated table of { name, text, size }, in the order given.
set(body "")
set(entries "")
set(i 0)
foreach(f IN LISTS FILES)
  file(READ "${f}" hex HEX)
  string(REGEX REPLACE "(..)" "0x\\1," hex "${hex}")
  get_filename_component(name "${f}" NAME)
  string(APPEND body "static const unsigned char k${i}[] = {${hex}0x00};\n")
  string(APPEND entries "    {\"${name}\", reinterpret_cast<const char*>(k${i}), sizeof(k${i}) - 1},\n")
  math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}" "// Generated by wowcore/cmake/embed.cmake; do not edit.\n#include \"wowcore/embedded.hpp\"\nnamespace wowcore {\n${body}extern const EmbeddedFile ${SYMBOL}[] = {\n${entries}    {nullptr, nullptr, 0}};\n}  // namespace wowcore\n")
